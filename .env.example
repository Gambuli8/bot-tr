# ─────────────────────────────────────────
#  BINANCE TESTNET
#  Obtené las keys en: https://testnet.binance.vision
# ─────────────────────────────────────────
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_secret_here
BINANCE_TESTNET=true

# ─────────────────────────────────────────
#  CLAUDE API
#  https://console.anthropic.com
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────
#  TELEGRAM
#  Crear bot con @BotFather → obtener token
#  Tu chat_id lo obtenés hablando con @userinfobot
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Opcional: chats con permisos completos / sólo lectura (CSV de chat_ids)
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_READONLY_CHAT_IDS=

# ─────────────────────────────────────────
#  TRADING CONFIG
# ─────────────────────────────────────────
TRADING_SYMBOL=BTC/USDT           # símbolo primario (retrocompat / single-symbol)
# Multi-symbol: lista de pares a escanear y operar (separados por coma).
# Acepta "ETHUSDT" o "ETH/USDT". Si está vacío, opera sólo TRADING_SYMBOL.
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,AVAX/USDT
# Candado de exposición global: máx. posiciones abiertas en simultáneo en TODO
# el portafolio. Protege el pool compartido (2 × 2.5% = 5% riesgo concurrente).
MAX_CONCURRENT_TRADES=2
TRADING_TIMEFRAME=15m
INITIAL_CAPITAL=210
MAX_RISK_PER_TRADE=0.025          # 2.5% del capital por trade
DAILY_DRAWDOWN_LIMIT=0.05         # 5% cortacorrientes diario
MIN_CLAUDE_CONFIDENCE=0.55

# ─────────────────────────────────────────
#  MODO TESTING (sin Claude, motor técnico local)
# ─────────────────────────────────────────
TESTING_MODE=false                # true → opera sin Claude usando TechnicalEngine
TESTING_LOOP_SECONDS=60           # ciclo en testing mode

# ─────────────────────────────────────────
#  MEJORAS VALIDADAS POR BACKTEST (ver docs/BACKTESTS.md)
# ─────────────────────────────────────────
ADX_MIN_TRENDING=20               # filtra mercado lateral, sube WR ~6pp
USE_KELLY_SIZING=true             # sizing dinámico según edge histórico
REQUIRE_MTF_CONFLUENCE=true       # descarta setups contra tendencia 1h

# ─────────────────────────────────────────
#  TP ESCALADO + BREAKEVEN (pendiente de validar con data real, ver BACKTESTS.md)
# ─────────────────────────────────────────
# Toma ganancia parcial en TP1 (a TP1_R_MULTIPLE × la distancia del SL) y mueve
# el SL a breakeven: la segunda mitad pasa a ser "trade gratis".
# Dejar en false hasta validar con `scripts/backtest.py --scaled-tp` vs baseline.
SCALED_TP=false
TP1_R_MULTIPLE=1.0                # TP1 a 1× el riesgo (R:R 1:1)
TP1_SIZE_PCT=0.5                  # fracción cerrada en TP1 (50%)
BREAKEVEN_AFTER_TP1=true          # mover SL al entry tras TP1

# ─────────────────────────────────────────
#  SCHEDULE (opcional)
# ─────────────────────────────────────────
# Horario activo UTC. Vacío = 24/7. AR = UTC-3.
# Ej. "12-2" = 9 AR a 23 AR. Soporta multi-rango "11-23,2-5".
ACTIVE_HOURS_UTC=
