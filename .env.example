# ─────────────────────────────────────────
#  BINANCE FUTURES USDT-M (Fase 3 — desde 2026-06-08)
#  TESTNET: https://testnet.binancefuture.com   (⚠ distinto del Spot testnet)
#  PROD:    https://www.binance.com/en/my/settings/api-management → "Enable Futures"
#
#  ⚠ Las API keys de Spot NO funcionan en Futures. Necesitás generar keys
#    específicas con permiso "Enable Futures Trading" activado.
#  ⚠ NO actives "Withdraw" en las keys (defensa básica).
# ─────────────────────────────────────────
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true                  # false en producción real

# ─────────────────────────────────────────
#  CLAUDE API (solo si ENGINE=claude)
#  https://console.anthropic.com
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────
#  TELEGRAM
#  Crear bot con @BotFather → obtener token
#  Tu chat_id lo obtenés con @userinfobot
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ADMIN_CHAT_IDS=               # CSV opcional con permisos full
TELEGRAM_READONLY_CHAT_IDS=            # CSV opcional con permisos sólo lectura

# ─────────────────────────────────────────
#  TRADING CONFIG (Fase 3 — Binance Futures USDT-M, leverage 7×)
# ─────────────────────────────────────────
TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=1h                   # PA validado en 1h (NO 5m/15m/30m)
INITIAL_CAPITAL=70                     # $210 / 3 bots = $70 por bot (Fase 3)
MAX_RISK_PER_TRADE=0.05                # 5% por trade — bajado de 8% por riesgo de liquidación con 7×
DAILY_DRAWDOWN_LIMIT=0.05              # 5% cortacorrientes diario
MIN_CLAUDE_CONFIDENCE=0.55
MAX_CONCURRENT_TRADES=1                # 1 posición simultánea por bot (3 bots × 1 = 3 trades simultáneos max)

# ─── Futures USDT-M ───
LEVERAGE=7                             # Validado por WFA (BTC/SOL/AVAX ✅)
MARGIN_MODE=isolated                   # isolated: liquidación NO contagia el resto del wallet

# ─────────────────────────────────────────
#  MOTOR DE DECISIÓN
#  scalping     → BB squeeze + expansion, TF 5m  (recomendado, validado en backtest)
#  price_action → Liquidity sweeps 1h + 4h structure
#  technical    → Legacy (perdedor en backtest 90d+)
#  claude       → Usa Anthropic API
# ─────────────────────────────────────────
ENGINE=scalping
TESTING_MODE=true                      # legacy (true = usa motor local; deprecado por ENGINE)
TESTING_LOOP_SECONDS=60                # ciclo en modo testing

# ─────────────────────────────────────────
#  MEJORAS HISTÓRICAS (sólo aplican a engine=technical o claude)
# ─────────────────────────────────────────
ADX_MIN_TRENDING=20
USE_KELLY_SIZING=true
REQUIRE_MTF_CONFLUENCE=true

# ─────────────────────────────────────────
#  SCHEDULE
#  Vacío = 24/7 (recomendado para producción).
#  Formato: "HH-HH" en UTC. Ej. "12-2" = 9 AR a 23 AR.
# ─────────────────────────────────────────
ACTIVE_HOURS_UTC=

# ─────────────────────────────────────────
#  SCALPING ENGINE — Skip de horario (DESACTIVADO POR DEFAULT)
#  scalp_skip_hours_utc: horas UTC en las que NO operar.
#  ⚠ El filtro 6-11 mostró +10× retorno en 60d pero NO sobrevivió WFA
#  out-of-sample (2 OS positivos de 7 ventanas, retorno total OS -17.74%).
#  Se deja la variable disponible para experimentación pero VACÍA por default.
#  Formato: "6-11" o "6,7,8,9,10,11". Vacío = sin filtro.
# ─────────────────────────────────────────
SCALP_SKIP_HOURS_UTC=

# ─────────────────────────────────────────
#  MONITOREO / DEAD-MAN'S SWITCH (roadmap #1)
#  Si seteás HEALTHCHECK_URL (ej. una check de healthchecks.io), el bot le pega
#  un ping en cada ciclo. Si los pings DEJAN de llegar (VPS apagado, Docker
#  muerto, red caída o loop colgado), el servicio externo te alerta a vos.
#  Vacío = desactivado (sólo queda el heartbeat local + healthcheck de Docker).
# ─────────────────────────────────────────
HEALTHCHECK_URL=
