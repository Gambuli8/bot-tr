# ───────── BingX ─────────
# API key de BingX con permiso de "Perpetual Futures Trading" (SIN permiso de retiro).
# La misma key sirve para demo (VST) y real: lo que cambia es BINGX_MODE.
BINGX_API_KEY=
BINGX_API_SECRET=
# demo = dinero falso (VST) · live = dinero real
BINGX_MODE=demo

# ───────── Estrategia ─────────
# SL: fib (0,786) · atr (0,75 − 0,1×ATR 1H) · structure (inicio del impulso − 0,1×ATR 1H)
SL_MODE=fib
# true = sólo operar a favor de la EMA50 diaria
FILTER_TREND=false

# ───────── Tamaño de la operación ─────────
# margin = margen fijo (MARGIN_PER_TRADE_USDT) · risk = riesgo fijo en USDT (RISK_PER_TRADE_USDT)
SIZING_MODE=margin
RISK_PER_TRADE_USDT=0.5

# ───────── Operativa ─────────
SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,ZEC-USDT,DOGE-USDT
# Margen fijo por operación (USDT). El apalancamiento se calcula solo (el mínimo que acepte BingX).
MARGIN_PER_TRADE_USDT=2
MAX_LEVERAGE=20
# ISOLATED: lo máximo que se puede perder en una operación es su margen.
MARGIN_TYPE=ISOLATED
# Riesgo/beneficio mínimo (neto de comisiones) para aceptar una entrada.
MIN_RR=1.5
MAX_OPEN_POSITIONS=3
# Si las pérdidas del día llegan a este monto, no abre más operaciones hasta mañana.
DAILY_LOSS_LIMIT_USDT=3
# Descarta la señal si llegó con más de N segundos de atraso o si el precio se movió más de N%.
MAX_SIGNAL_AGE_S=180
MAX_SLIPPAGE_PCT=0.4

# ───────── Origen de las señales ─────────
# internal    = el bot analiza solo con velas de BingX (gratis, recomendado)
# tradingview = las entradas llegan por alertas webhook de TradingView (plan pago)
STRATEGY_SOURCE=internal

# ───────── Modo carry: captura de funding (spot + short) ─────────
# Requiere que la API key tenga permiso de trading SPOT y de transferencias internas (NUNCA retiros).
# Los pares del carry quedan fuera de la estrategia direccional.
CARRY_ENABLED=false
CARRY_SYMBOLS=BTC-USDT,ETH-USDT,DOGE-USDT,XRP-USDT
# Capital total del carry (se reparte en partes iguales entre los pares)
CARRY_CAPITAL_USDT=200
CARRY_LEVERAGE=2
# Protege/recentra cuando el precio se mueve ±CARRY_REBALANCE_PCT/CARRY_LEVERAGE (0,3/2 = 15 %)
CARRY_REBALANCE_PCT=0.3
# Reinvierte lo acumulado cuando supera este % del capital (mínimo cada 7 días)
CARRY_REINVEST_PCT=0.03
CARRY_MIN_TRADE_USDT=5
CARRY_INTERVAL_S=300
# Moneda de las transferencias internas: vacío = automático (VST en demo, USDT en real)
CARRY_ASSET=
# auto = simulado en demo (la demo de BingX no opera spot con VST) · true = siempre simulado · false = órdenes reales
CARRY_PAPER=auto

# ───────── TradingView (sólo si STRATEGY_SOURCE=tradingview) ─────────
# Clave compartida que va dentro del JSON de cada alerta. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Sólo acepta webhooks desde las IPs oficiales de TradingView.
ENFORCE_TV_IPS=true

# ───────── Telegram ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# IDs autorizados a dar comandos (CSV). Vacío = sólo TELEGRAM_CHAT_ID.
TELEGRAM_ADMIN_IDS=

# ───────── Google Drive (resúmenes) ─────────
# Opcional. Ver bot/google_auth.py para obtener el refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Vacío = el bot crea la carpeta "Bot Trading BingX" en tu Drive.
GOOGLE_DRIVE_FOLDER_ID=

# ───────── Runtime ─────────
TIMEZONE=America/Argentina/Buenos_Aires
MONITOR_INTERVAL_S=20
